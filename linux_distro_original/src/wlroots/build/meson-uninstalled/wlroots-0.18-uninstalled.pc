prefix=/root/src/wlroots/build
includedir=${prefix}/include
libdir=${prefix}/lib
srcdir=/root/src/wlroots

Name: wlroots-0.18
Description: Wayland compositor library
URL: https://gitlab.freedesktop.org/wlroots/wlroots
Version: 0.18.2
Requires.private: wayland-server >= 1.23, libdrm >= 2.4.122, xkbcommon, pixman-1 >= 0.42.0, libudev, libseat >= 0.2.0, libdisplay-info, libinput >= 1.19.0, wayland-client
Libs: -L${prefix} -lwlroots-0.18
Libs.private: -lm -lrt
Cflags: -I${prefix}/include -I${srcdir}/include -I${prefix} -I${srcdir}
